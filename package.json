{
  "name": "reunite-now",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:demo": "DEMO_DATA=true npm run dev",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "test": "tsx --test tests/metrics.test.ts tests/storage.test.ts tests/i18n.test.ts",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "reminders": "tsx server/reminders-cli.ts",
    "test:integration": "tsx --test tests/api.test.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/identity": "^4.14.1",
    "@electric-sql/pglite": "^0.3.14",
    "arctic": "^3.7.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "prettier": "^3.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
