# Local development uses an embedded PostgreSQL-compatible database when omitted.
DATABASE_URL=
DB_SSL=false
APP_URL=http://127.0.0.1:5173
PORT=3001
# Email sign-in and optional reminders; configure after domain verification.
AZURE_COMMUNICATION_ENDPOINT=
# Connection string is optional if using managed identity.
AZURE_COMMUNICATION_CONNECTION_STRING=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set a long random value to authorize the reminder job endpoint.
CRON_SECRET=
# Local only; never enabled in production.
DEV_AUTH=true
