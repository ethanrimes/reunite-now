# Local development uses an embedded PostgreSQL-compatible database when omitted.
DATABASE_URL=
DB_SSL=false
APP_URL=http://127.0.0.1:5173
PORT=3001
# Email sign-in and optional reminders; configure after domain verification.
AZURE_COMMUNICATION_ENDPOINT=
# Connection string is optional if using managed identity.
AZURE_COMMUNICATION_CONNECTION_STRING=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web OAuth clients use APP_URL/api/auth/{provider}/callback.
# Apple requires a registered HTTPS domain and a Services ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Register a web app for personal Microsoft accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Set a long random value to authorize the reminder job endpoint.
CRON_SECRET=
# Local only; never enabled in production.
DEV_AUTH=true

# Production requires two distinct PostgreSQL databases. DATABASE_URL is for local single-database development.
DATABASE_URL_EU=
DATABASE_URL_US=

# Set both only after running the release migration and provisioning distinct
# reader/runtime logins in both databases. Their presence disables web startup DDL.
DATABASE_READER_URL_EU=
DATABASE_READER_URL_US=
